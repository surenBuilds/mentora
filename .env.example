# Telegram բոտի token (ստացիր @BotFather-ից)
TELEGRAM_BOT_TOKEN=

# Ինքնաշխատ լրացվում է, երբ դու /start ես գրում բոտին։
# Կարող ես նաև ձեռքով նշել, եթե գիտես քո chat id-ն։
TELEGRAM_CHAT_ID=

# Gemini API բանալի (ունես արդեն Voxline-ի նախագծերում)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Tavily API բանալի՝ իրական web որոնման համար (անվճար tier՝ tavily.com)
# Եթե դատարկ թողնես, բոտը կաշխատի, բայց digest-ը կլինի Gemini-ի սեփական
# գիտելիքի հիման վրա, ոչ թե թարմ հոդվածների։
TAVILY_API_KEY=

# Ուղարկման ժամանակացույց (cron ֆորմատ). լռելյայն՝ ամեն օր 09:00
SEND_TIME=0 9 * * *
TIMEZONE=Asia/Yerevan

# Լռելյայն ոլորտներ (փոփոխելի նաև /settopics հրամանով)
DEFAULT_TOPICS=բիզնես,մարքեթինգ,վաճառք,ձեռնարկատիրություն,պատմություն,ներդրումներ,ընդհանուր գիտելիքներ

# Ուր պահել state.json-ը (Railway-ում կցրած volume-ի path, եթե ունես)
DATA_DIR=./data
